# The password for the bundled Postgres. Set it before the first `up`: the
# database is created with whatever is here the first time it starts, and
# changing it afterwards locks you out of your own data rather than rotating
# anything. `openssl rand -hex 16` will do; any character is fine, `@`, `#`
# and `%` included: it reaches the database apart from the URL.
POSTGRES_PASSWORD=

# Where the database is. Inside docker-compose.yml you do not set this: the
# compose file builds it from POSTGRES_PASSWORD above and passes it in, so that
# one password lives in one place instead of two that have to agree. Editing
# the line below changes nothing while you run under compose.
#
# It is here for the other case: pointing this application at a Postgres you
# already run. Then set it, and leave POSTGRES_PASSWORD empty, or set the
# password there and leave it out of the URL. One written into the URL has its
# `@`, `#`, `%`, `:` and `/` percent-encoded (`@` is %40).
# DATABASE_URL=postgresql://user:password@host:5432/korely

# The model key. The facts are the only thing here that calls a model (and
# the vectors, if you choose Gemini's below): a background worker mines them a
# few seconds after each write, not inside the request. Optional here: the
# first login asks where your memories are written (Europe: Scaleway or
# Mistral; Global: Gemini, OpenAI, Claude, Grok or OpenRouter) and for that
# provider's key, and that choice
# wins over these lines until Settings, Writing model, "Use what .env says
# instead" gives them back. `python3 scripts/choose_models.py` writes them for
# you from a terminal.
#
# Without a key the store still accepts writes and answers reads, and mines
# nothing: /health says "state": "not configured" and the log says so at
# startup. A memory written while there is no key waits, `pending`: the
# worker mines it within seconds of a key arriving, billed to that key, with
# nothing to run.
GOOGLE_API_KEY=

# Or any OpenAI-compatible provider, for the reading, the judge and the
# vocabulary: Mistral or Scaleway inside the EU, or anything that speaks the
# same API on your own network.
# Exactly `mistral`, in lower case, selects this door; any other value or
# no line writes with Gemini.
# EXTRACTION_PROVIDER=mistral
# MISTRAL_API_KEY=
# MISTRAL_API_BASE=https://api.mistral.ai/v1

# The models, when the lines above name the provider: a provider chosen on the
# screen brings its own model and wins over these. The facts, the
# contradiction judge and the vocabulary ask the same model, unless
# VOCABULARY_MODEL names another. `python3 scripts/choose_models.py` writes
# the line for the host you pick.
#
# Gemini's, with GOOGLE_API_KEY:
# EXTRACTION_MODEL=gemini-3.1-flash-lite
#
# The model asked of MISTRAL_API_BASE, with EXTRACTION_PROVIDER=mistral. The
# default is a name of Mistral's own API; Scaleway, OpenRouter or a server on
# your own network serve their own names (on Scaleway, gpt-oss-120b is the
# European writer we measured), and a host that does not serve the name asked
# refuses every call, so no memory gains facts. Set it to a name your host
# serves:
# MISTRAL_EXTRACTION_MODEL=mistral-small-latest
#
# The model that decides the relation vocabulary, of the same provider; unset,
# it is the one above. A Gemini name here with EXTRACTION_PROVIDER=mistral
# stops the service at start, with what to set instead.
# VOCABULARY_MODEL=

# Where the vectors are computed. `local`, the default: on this machine, with
# EmbeddingGemma-300m. No key, and no text leaves the machine to be searched;
# the image carries the model, about 1.2 GB. `gemini`: Google, with
# GOOGLE_API_KEY, and an image without the model; without that key, search by
# meaning is off. Decide before the first `docker compose up`: changing it
# later means building again and computing the stored vectors again
# (docs/guide/install.md, step 7), and the service does not start on another model's vectors.
# An install upgraded from 0.1.18 or earlier without this line has Gemini's.
# EMBEDDING_PROVIDER=gemini
#
# Gemini's vector model, with EMBEDDING_PROVIDER=gemini only. A model whose
# distance thresholds nobody has measured stops the service at start.
# EMBEDDING_MODEL=gemini-embedding-2-preview

# Requests per minute per tenant. 0 disables it. Protects your database and
# your model bill from one agent stuck in a retry loop; there is no metering
# and nothing is billed.
RATE_LIMIT_PER_MINUTE=0

# The domain this is served on. Set it and Caddy gets a real certificate
# automatically. A server with no DNS name yet: your IP with dashes, not dots,
# plus .nip.io (203.0.113.7 -> 203-0-113-7.nip.io; docs/guide/install.md says why dashes).
# Leave it empty only on a laptop: you get `localhost`, with a certificate from
# Caddy's own local authority, which your machine does not trust until you tell
# it to. "On a laptop" in docs/guide/install.md has the ways through.
DOMAIN=

# The address clients reach this install at, advertised in the OAuth and MCP
# metadata that ChatGPT and Claude read to connect. Left unset, it is
# https://DOMAIN (with HTTPS_PORT when that is not 443). Set it only when a
# proxy of yours serves this install at another address.
# PUBLIC_BASE_URL=https://memory.example.com

# Which proxies the API believes about the client's address (X-Forwarded-For)
# and scheme: names, addresses or networks, comma-separated. `caddy` in the
# image: the Caddy this stack ships, by its service name. Behind a proxy of
# yours, name that proxy (docs/guide/operations.md, "Your own proxy in front").
# FORWARDED_ALLOW_IPS=caddy

# Where certificates are requested from. Leave it alone in production.
#
# Let's Encrypt allows five certificates a week for the same exact name, and a
# `docker compose down -v` throws away the one you had along with the volume
# that held it. Rebuilding the same machine five times in a week is a normal
# thing to do while evaluating and it uses them all up; the sixth attempt gets
# nothing, with no page and no warning. The staging directory has limits you
# will not reach, and issues a certificate a browser does not trust:
#
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# What install.sh adds below the rest, read by `docker compose` itself: the
# name Docker gives this install's containers and volumes (unset, it is the
# folder's name), and, for an install from the published image instead of a
# build, the second compose file and the image it runs (docker-compose.image.yml
# says why there is no `latest`).
# COMPOSE_PROJECT_NAME=korely
# COMPOSE_FILE=docker-compose.yml:docker-compose.image.yml
# KORELY_IMAGE=ghcr.io/korely-ai/korely:<version>

# Where the API listens on loopback, behind Caddy. Change it only if 8000 is
# taken on the host. It serves the dashboard too, on plain HTTP, reachable only
# from this machine: on a laptop that is the address to try it on.
PORT=8000

# The ports Caddy takes on the host. Change them only if something already
# holds 443 or 80; a real certificate from Let's Encrypt needs both on the
# defaults, so this is for a laptop or a machine behind another proxy.
# HTTPS_PORT=443
# HTTP_PORT=80

# The API's memory ceiling (docker-compose.yml, mem_limit). 1.5 GB is twice the
# highest measured (0.77 GB with the local embedder, 16 parallel clients).
# API_MEMORY_LIMIT=1536m

# Log every SQL statement. Useful once, noisy forever.
SQL_ECHO=false

# What /v1/ping reports as `region`: a label you set to where the machine and
# the database are, `eu` when unset. The service cannot check it, and its
# clients read it as you wrote it.
# REGION=eu

# Webhooks. A webhook URL is an address this server connects to, chosen by
# whoever holds an API key, so registration refuses plain http and anything
# resolving to a loopback, private, link-local or reserved address. Turn these
# on only to point at something on your own machine during a test.
# WEBHOOK_ALLOW_HTTP=false
# WEBHOOK_ALLOW_PRIVATE_URLS=false

# How long a model call may take before it is abandoned, so that a stalled
# provider does not hold the worker (or, with WRITE_ASYNC=false, the request
# that wrote the memory) and an open transaction.
# LLM_TIMEOUT_SECONDS=60

# Where the facts are mined. true, the default: POST /v1/memories answers as
# soon as the memory is stored, `processing`, and the worker mines it a few
# seconds later. false: the request mines it and answers with its facts, after
# the model's seconds.
# WRITE_ASYNC=true

# What a token costs here. Optional. Without it the consumption report still
# answers with the call counts and leaves the money blank, which is the honest
# shape when nobody has said what a token costs on this install.
#
# Deliberately not in the database: a price is an assumption that changes, and
# writing it next to the tokens would make last quarter's report move the day
# the provider moves. The tokens are the fact; the money is arithmetic done
# when you read it.
#
# The example prices EXTRACTION_MODEL's default, the Global writer, at
# Google's list price as of October 2026: check the provider's page, and add a
# line for each model this install calls (the Usage page names the ones
# without a price).
#
# LLM_RATES={"currency":"USD","models":{"gemini-3.1-flash-lite":{"input_per_million":0.25,"output_per_million":1.50}}}

# Encrypts the model provider, key and models when somebody saves them from
# the dashboard, and the secret of an OAuth client that registers with one;
# and keys the pseudonym an erasure leaves in place of an end user's id. Any
# long random string; `openssl rand -hex 32` will do. Without it, saving a
# key from the screen refuses rather than writing it into the database in
# clear text, and the page says so.
#
# Keep it, and keep it with the backups. Changing it makes the choice saved on
# the screen unreadable: no memory is mined until it is saved again, unless
# this file names a provider, and the page says the stored key will not
# decrypt. An OAuth client registered with a secret becomes unknown and
# registers again. And the erasures' pseudonyms no longer match the ids, so
# GET /v1/audit?user_id= stops finding those records.
SECRET_KEY=

# To rotate SECRET_KEY (after a leak, say), put the new value above and the
# old one here: it is read, never written with, so all of the above keeps
# working (since 1.0.27). Newest first, comma separated. Then
# `python -m korely_agent.manage reseal-secrets` seals again under the new
# value what the old one sealed. Drop an old value only when nothing it keyed
# is still needed: the erasures' pseudonyms keep it for as long as their
# records are kept (docs/guide/operations.md, "Rotating SECRET_KEY").
# SECRET_KEY_FALLBACKS=

# How long a login to the dashboard lasts.
# SESSION_HOURS=12

# SSO, for a service that has no identity provider of its own. Name the header
# your gateway sets once it has authenticated somebody, e.g. X-Forwarded-User,
# and whoever it names is logged in as that operator.
#
# YOUR GATEWAY MUST STRIP THIS HEADER FROM INCOMING REQUESTS. If it does not,
# anybody who can reach this service can set it and become any operator.
# Binding the API to loopback is not enough: the Caddy this stack ships faces
# the internet and passes the header on as the client sent it. Turn this on
# only when the proxy facing the internet removes the header from every
# request and sets it itself after authenticating (with Caddy, a
# `request_header -X-Forwarded-User` before the gateway's `forward_auth`).
# TRUST_AUTH_HEADER=

# Write the facts out as readable Markdown as well, one file per end user, into
# this directory. The database stays the source of truth; nothing reads these
# back. Under docker-compose.yml, /data/facts is ./facts on the host, and files
# land in ./facts/<tenant id>/<end user>.md. Put ./facts under git and
# `git diff` shows what the agent learned. It holds people's data, like
# backups/: keep it off anything public.
# FACTS_EXPORT_DIR=/data/facts
# FACTS_EXPORT_EVERY_SECONDS=300

# The background worker. It runs inside the API process; RUN_WORKER=false and
# `python -m korely_agent.worker` run it on its own instead. How much each job
# takes per tick: memories mined for facts (every 10 s), /v1/batch jobs (every
# 30 s, each one a whole payload with its extraction), webhook deliveries
# (every 15 s, each one able to wait on an endpoint that does not answer),
# vectors a write could not get, retried (every 30 s, that many memories and
# as many facts, one embedding call each).
# DRAIN_LIMIT=20
# BATCH_DRAIN_LIMIT=5
# WEBHOOK_DRAIN_LIMIT=20
# VECTOR_DRAIN_LIMIT=50
#
# A vector for each window of a long memory (100 words, a new window every
# 50), off by default (1.0.33): a search then ranks a memory by its best
# window too, and the context block shows a long memory by the sentences of
# that window. One vector per window, computed by the worker's job `windows`,
# at most 20 a pass every 30 seconds: this machine's CPU with
# the local embedder, one call to Google each with EMBEDDING_PROVIDER=gemini.
# After turning it on, `docker compose run --rm api python -m
# korely_agent.manage memory-windows --apply` makes the windows of the
# memories stored before (docs/guide/operations.md).
# MEMORY_WINDOWS=false
#
# How long, in minutes, a memory the worker took may stay in its hands before
# it goes back in the queue when nothing says its process has ended (a call
# that hung; a worker that stopped or was killed gives its memories back at
# once since 1.0.22, docs/guide/troubleshooting.md), and how
# long one group of an end user's memories may run before the worker gives up
# on its thread (a pass itself collects its groups for two seconds and goes on;
# the group finishes in its thread); a /v1/batch job still running after as
# long is marked failed, to be retried.
# DRAIN_STALE_MINUTES=15

# Where the built dashboard is served from. The image puts it here; another
# directory serves a page you built yourself, and one that does not exist runs
# the service with no screen.
# DASHBOARD_DIR=/app/static

# Leave it as it is. `hosted` is the mode of the Korely Cloud: this same
# code with the Cloud's own package (korely_agent/hosted/), which switches on
# accounts, billing and that service's limits. An install without that
# package refuses it at start.
# KORELY_MODE=self_hosted

# How long the worker keeps its own records, in days, trimmed once an hour.
# 0 (or less) keeps them forever, and anything longer than a century (36500)
# is read as a century. The audit trail and the model usage are evidence (who
# touched which end user's data; which agent spent what), so a year and some;
# a finished webhook delivery only says whether an endpoint got its events.
# AUDIT_RETENTION_DAYS=400
# LLM_USAGE_RETENTION_DAYS=400
# WEBHOOK_DELIVERY_RETENTION_DAYS=30
# Which fact an agent that named itself as `reader` was handed, and when
# (agent notices): kept 90 days after its last read.
# READ_MARKS_RETENTION_DAYS=90
# (Finished /v1/batch jobs go after seven days, and that one is not a setting:
# their payloads are copies of people's memories. services/batch.py says why.)
